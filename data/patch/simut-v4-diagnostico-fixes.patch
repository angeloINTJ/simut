+static void test_A3_negative_hundredth_is_not_nan(void) {
+    HistV4State st;
+    buildTestSchema(st, 1);
+    st.measures[0].channel  = 0;    /* CH_TEMP: signed */
+    st.measures[0].bitWidth = 16;
+    st.measures[0].scale    = 100;
+
