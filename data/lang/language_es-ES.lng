do...","dash_eval":"Evaluando...","dash_metr_min":"min","dash_metr_max":"max","dash_metr_ok":"ok","dash_metr_fail":"fallos","dash_metr_retry":"retry","dash_metr_last":"últ.","dash_metr_err":"error","dash_free":"Libre","dash_tot":"Total","greet_hello":"Hola","greet_morning":"Buenos días","greet_afternoon":"Buenas tardes","greet_evening":"Buenas noches","hist_none_sel":"Ninguno","hist_n_sel":"seleccionados","m_jan":"Ene","m_feb":"Feb","m_mar":"Mar","m_apr":"Abr","m_may":"May","m_jun":"Jun","m_jul":"Jul","m_aug":"Ago","m_sep":"Sep","m_oct":"Oct","m_nov":"Nov","m_dec":"Dic","hist_done":"Completado","hist_down_msg":"Cargando...","hist_err_json":"Error.","hist_no_data":"Sin datos.","hist_conn_lost":"Conexión perdida.","hist_ref":"Actualizar","hist_none":"Ningún evento.","hist_clear_msg":"¿Borrar logs?","display_busy":"Pantalla en uso. Intente nuevamente en unos segundos.","hist_clear_err":"Fallo al borrar logs.","hist_cleared":"Logs borrados.","net_conn_err":"Error de conexión.","exp_no_chart":"Cargue un intervalo en el gráfico","exp_cancelled":"Cancelado","exp_empty":"Sin datos en este período","exp_logs_empty":"Haga clic en 'Cargar' primero","exp_rows":"filas","cfg_sec_mqtt":"Usar MQTTS (TLS)","cfg_time_need":"Complete fecha y hora.","cfg_time_ok":"Hora aplicada.","cfg_time_fail":"Fallo al aplicar.","cfg_touch_confirm":"¿Restablecer la calibración táctil a los valores de fábrica?","cfg_touch_done":"Calibración resetada. Recalibre por display.","sens_load_fail":"No se pudieron cargar los slots de sensores.","sens_free":"libre","sens_active":"Activo","sens_none":"Ningún slot de sensor configurado todavía.","sens_empty":"vacío","sens_hwid_hint":"Clave usada por el historial y por la telemetría. Cambiarla inicia una serie nueva.","sens_state":"Estado","sens_alarms":"Alarmas habilitadas","sens_pins":"Asignación de GPIO","sens_pin":"Pin","sens_calib":"Calibración","sens_reading":"Lectura actual","sens_ref":"Temperatura de referencia medida con un instrumento confiable","sens_ref_hint":"El dispositivo guarda la diferencia como offset. Requiere NTP sincronizado.","sens_ntp_no":"NTP no sincronizado.","sens_ref_h":"Humedad de referencia medida con un instrumento confiable","sens_ref_of":"Valor de referencia medido con un instrumento confiable","sens_ref_p":"Presión de referencia medida con un instrumento confiable","sens_hist":"Grabación en el historial","sens_rebind_hint":"Un slot agregado o renombrado hoy no tiene columna en el archivo de historial del día, así que no se graba hasta mañana. Esto reescribe ese archivo para todos los slots, conservando los registros ya tomados. El dispositivo se reinicia al final.","sens_rebind":"Recomponer el historial ahora","sens_hw":"Hardware","sens_accept_hint":"Vuelve a leer la sonda conectada a este slot y vincula el slot a ella. Úselo tras cambiar un DS18B20, cuando el dispositivo informe discrepancia de hardware.","sens_accept":"Adoptar la sonda conectada aquí","sens_wipe_hint":"Marca todo lo grabado antes de ahora como perteneciente al sensor anterior. Los registros siguen en el disco; lo que cambia es que los gráficos dejan de atribuirlos a este slot.","sens_wipe":"Restablecer época del historial","sens_free_slot":"Liberar slot","sens_revert":"Descartar cambios","sens_done":"Completado","sens_stage_hint":"Las ediciones se acumulan mientras escribe y se graban al Guardar y Reiniciar.","sens_scan_busy":"Buscando...","sens_scan_none":"Ninguna sonda respondió.","sens_scan_found":"encontrada(s)","act_fail":"Fallo en la acción.","sens_accept_ok":"Slot vinculado a la sonda encontrada en él.","sens_accept_none":"Ninguna sonda respondió en este GPIO.","sens_accept_bad":"La sonda respondió con una ROM inválida.","sens_wipe_confirm":"¿Restablecer la época del historial de este slot?\n\nLos registros tomados antes de ahora dejan de atribuírsele. No se borra nada.","sens_wipe_ok":"Época del historial restablecida.","tel_sync_ok":"Envío disparado. Siga el resultado en el registro.","tel_reset_confirm":"¿Restablecer el cursor de telemetría?\n\nEl dispositivo reenviará hasta 30 días de historial en el próximo envío. Espere una ráfaga de tráfico.","tel_reset_ok":"Cursor restablecido. Los próximos envíos cubren hasta 30 días atrás.","sens_rebind_pending":"Guarde y Reinicie antes — recomponer ahora usaría la configuración anterior.","sens_rebind_confirm":"¿Reescribir el archivo de historial del día para los slots actuales?\n\nLos registros ya tomados se conservan. El dispositivo se reinicia al final.","sens_rebind_busy":"Reescribiendo...","sens_rebind_ok_forced":"Historial reconstruido","sens_rebind_meas":"mediciones","sens_rebind_ok":"Historial reescrito","sens_rebind_recs":"registros conservados","sens_rebind_reboot":"Reiniciando...","sens_rebind_force":"El archivo de historial del día no se pudo leer, así que los registros no se pueden aprovechar.\n\n¿Recrearlo vacío? Los registros de hoy se pierden. Los días anteriores quedan intactos.","sens_rebind_kept":"Nada cambió.","sens_rebind_err":"Fallo al reescribir","sens_rebind_unsure":"Sin respuesta del dispositivo. Recargue la página y revise el log antes de intentarlo de nuevo.","sens_need_type":"Elija un tipo antes de activar este slot.","sens_need_pin":"Asigne un GPIO al pin","sens_taken":"ya está en uso por el slot","sens_clear_confirm":"¿Liberar este slot? Se borran su tipo, GPIOs e identificación.","net_conn":"Conectado","net_off":"Desconectado","usr_pend_del":"Pendiente: Eliminar","usr_pend_rst":"Pendiente: Reset","usr_pend_add":"Pendiente: Nuevo","usr_del_msg":"¿Eliminar?","usr_rst_msg":"¿Forzar reset?","fil_parent":"Arriba","fil_empty":"Vacío","fil_protected":"Archivo protegido","fil_folder":"Carpeta","fil_uploaded":"Subida completada.","fil_up_err":"Error al subir.","fil_sel_del":"Seleccione","fil_conf_del":"¿Eliminar N?","fil_del_err":"Algunos archivos no pudieron ser eliminados.","fil_deleted":"Archivos eliminados.","fil_sel_down":"Seleccione","fil_conf_down":"¿Descargar N?","fil_backup_started":"Descarga del respaldo iniciada.","fil_rst_val":"Paso 1/3: Validando el respaldo (CRC + chip ID)...","fil_rst_val_fail":"Fallo la validación: ","fil_rst_confirm":"Respaldo válido — N archivos (X bytes).\n\nEsto SOBRESCRIBE los archivos actuales del dispositivo (history, configs, sensores, themes).\nSe restaurarán la configuración de Wi-Fi y la contraseña de admin del respaldo.\n\n¿Continuar con la restauración?","fil_rst_app":"Paso 2/3: Aplicando la restauración (puede tardar ~15 s)...","fil_rst_app_fail":"Fallo al aplicar: ","fil_rst_reb":"Paso 3/3: Reiniciando el dispositivo (~25 s)...","fil_rst_off":"Dispositivo sin conexión tras 90 s. Verifique la conexión y enciéndalo manualmente si hace falta.","fil_fw_warn":"Actualización de firmware vía OTA.\n\nLa partición de archivos se REFORMATEA — el área de staging comparte la partición con ella.\n\nSolo la configuración sobrevive (capturada antes, restaurada después):\n  • Wi-Fi, contraseña de administrador, telemetría\n  • Mapeo de sensores y límites de alarma\n\nTodo lo demás en el dispositivo se pierde:\n  • Historial de lecturas (/history)\n  • Paquetes de idioma (/lang)\n  • Temas personalizados (/themes)\n  • Calibración táctil (/calib)\n  • Archivos en /web\n  • El registro de eventos\n\nUn respaldo .bkp se descarga automáticamente — restáurelo después para recuperar todo.\n\n¿Continuar?","fil_fw_need_bin":"Seleccione un archivo .bin de firmware","fil_fw_bk":"Paso 1/4: Descargando el respaldo .bkp...","fil_fw_bk_fail":"Fallo al descargar el respaldo. Intente nuevamente.","fil_fw_bk_corrupt":"Respaldo corrupto (CRC). Abortado.","fil_fw_apply":"Respaldo guardado en su computadora.\n\n¿Iniciar la actualización?\n  • Subida del firmware: ~30 s\n  • Aplicación + reinicio: ~25 s\n  • Arranque completo: ~25 s\n\nTotal: ~80 s. No apague el dispositivo durante el proceso.","fil_fw_up":"Paso 2/4: Subiendo el firmware (~30 s)...","fil_fw_stage_fail":"Fallo en el envío (validación v=","fil_fw_app":"Paso 3/4: Aplicando el firmware...","fil_fw_reb":"Paso 4/4: Esperando el arranque (~25 s)...","pending_notice":"Click en \"Guardar y Reiniciar\" para aplicar los cambios.","commit_confirm":"Esto guardará todos los cambios y reiniciará el sistema.\n\n⚠️ El dispositivo quedará offline por ~10 segundos.\nCualquier grabación de historial/log en curso será interrumpida.\n\n¿Continuar?","calib_err":"Error de calibración: ","commit_btn":"💾 Guardar y Reiniciar","calib_timeout":"Tiempo agotado en la calibración. Intente nuevamente.","net_saved_port":"Guardado. Redirigiendo al nuevo puerto...","commit_saved":"¡Guardado! Reiniciando sistema...","commit_err":"Fallo al guardar.","cal_pts_hint":"Hasta 5 puntos por magnitud, cada uno ligando la lectura bruta al valor mostrado por un instrumento confiable. Un punto aplica un offset constante; más puntos doblan la corrección entre ellos, recta más allá de los extremos. Deje el bruto vacío para capturar la lectura al guardar.","cal_raw":"Bruto","cal_ref":"Referencia","cal_corr":"corregido","cal_cap":"Usar la lectura bruta actual","cal_del":"Quitar este punto","cal_add":"Añadir punto","cal_clear":"Quitar corrección","cal_none":"Sin corrección — valor del sensor.","cal_legacy":"Offset constante","cal_save_hint":"Las correcciones se graban en Guardar y Reiniciar. Requiere NTP sincronizado.","cal_err_max":"como máximo 5 puntos.","cal_err_num":"cada punto necesita bruto y referencia numéricos.","cal_err_noread":"sin lectura en vivo para capturar — rellene el valor bruto.","cal_err_rng":"punto fuera del rango plausible","cal_err_dup":"dos puntos con el mismo valor bruto.","cal_mode_lbl":"Interpolación","cal_mode_lin":"Recta","cal_mode_cub":"Suave","cal_mode_hint":"Suave es una cúbica monótona: dobla por las anclas sin jamás sobrepasarlas. Necesita 3+ puntos; con menos se comporta como recta."}
