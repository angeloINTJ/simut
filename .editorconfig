root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# A licence text is reproduced verbatim from the package that ships it, so the editor leaves it as it is:
# LICENSES/Liberation-OFL-1.1.txt has a space at the end of lines 29, 86 and 90 and a blank last line, and its
# sha256 (93fed460...) is the one of the LICENSE of the Liberation 2.1.5 tarball (2026-11-11). Four texts on
# main (2026-11-11) already end lines with a space: bearssl-MIT.txt, bricolage-grotesque-OFL-1.1.txt,
# littlefs-BSD-3-Clause.txt and newlib-COPYING.NEWLIB.txt. .pre-commit-config.yaml excludes the folder too.
# insert_final_newline is unset, not false. By the specification (0.17.2) false means "ensure the file does
# not end with a newline", and Neovim's built-in support does that on write (runtime/lua/editorconfig.lua,
# v0.10.4, read 2026-11-11, not run): 26 of the 28 texts here end with one. unset takes the [*] rule away and
# leaves the editor's own default. What is left is an editor that adds a newline by itself, to the two texts
# that have none (cyw43-driver-LICENSE.RP.txt and pico-sdk-BSD-3-Clause.txt).
[LICENSES/*]
trim_trailing_whitespace = false
insert_final_newline = unset
