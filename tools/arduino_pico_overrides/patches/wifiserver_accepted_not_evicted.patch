--- a/libraries/WiFi/src/WiFiServer.cpp
+++ b/libraries/WiFi/src/WiFiServer.cpp
@@ -192,10 +192,36 @@
     (void) err;
     DEBUGV("WS:ac\r\n");
 
+    /* SIMUT override — lwIP calls this with no pcb when it could not allocate
+     * one for a new connection (tcp_listen_input, tcp_in.c): there is nothing
+     * to accept; the SYN goes unanswered and the peer sends it again. Upstream
+     * built a ClientContext on the null pcb. That never ran while every
+     * connection could be killed to make room; with the priority below it can. */
+    if (!apcb) {
+        return ERR_MEM;
+    }
+
     // always accept new PCB so incoming data can be stored in our buffers even before
     // user calls ::available()
     ClientContext* client = new ClientContext(apcb, &WiFiServer::_s_discard, this);
 
+    /* SIMUT override — a connection this server accepted is not killed to admit
+     * another. ClientContext puts every connection at TCP_PRIO_MIN, and with the
+     * PCB pool full (MEMP_NUM_TCP_PCB is 5) tcp_alloc( ) admits a newcomer, at
+     * TCP_PRIO_NORMAL, by killing the most idle connection below that; a tie
+     * goes to the oldest. A web server serves one client at a time, so during a
+     * long request each poll of an open page waits here, a PCB each. A browser
+     * re-sends at once a poll that was reset, the queued ones stay as fresh as
+     * the request being served, and that request, the oldest, was the one
+     * killed: on the bench Pico 2 W (2026-10-03), a 1 MB upload at 50 KB/s was
+     * reset at 13.1 s, two times out of two, by a poller every 3 s that re-sent
+     * on a reset. At TCP_PRIO_NORMAL nothing here is killed for a newcomer: with
+     * the pool full, the newcomer's SYN goes unanswered (above) and is sent
+     * again, and no reset reaches a browser to be re-sent. With this, the same
+     * upload under the same poller ends in its answer at 19.9 s, two times out
+     * of two, as on a quiet bench. */
+    tcp_setprio(apcb, TCP_PRIO_NORMAL);
