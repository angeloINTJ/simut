     _freeSSL();
     _oom_err = false;
-    _sc_svr = std::make_shared<br_ssl_server_context>();
+    if (!s_srv_pool_busy &&
+            _iobuf_in_size + _iobuf_out_size <= (int)sizeof(s_srv_iobuf_pool)) {
+        s_srv_pool_busy = true;
+        _sc_svr = std::shared_ptr<br_ssl_server_context>(&s_srv_ctx_pool,
+                  [](br_ssl_server_context *) {});
+        _iobuf_in = std::shared_ptr<unsigned char>(s_srv_iobuf_pool,
+                    [](unsigned char *) {});
+        _iobuf_out = std::shared_ptr<unsigned char>(
+                     s_srv_iobuf_pool + _iobuf_in_size,
+                     [](unsigned char *) { s_srv_pool_busy = false; });
+    } else {
+        _sc_svr = std::make_shared<br_ssl_server_context>();
+        _iobuf_in = _alloc_iobuf(_iobuf_in_size);
+        _iobuf_out = _alloc_iobuf(_iobuf_out_size);
+    }
     _eng = &_sc_svr->eng; // Allocation/deallocation taken care of by the _sc shared_ptr
