+/* SIMUT override — static pool for the TLS *server* context + iobufs, v2:
+   reserved once at boot instead of living in BSS.
+   Measured on the rig (2026-08-20, autopsy hp=792, 4 independent samples):
+   Core 0 died inside the 16709-B iobuf malloc during the TLS accept, with
+   ~29 KB of free heap and the telemetry TLS *client* churning ~10 KB per
+   retry on the same heap. The web server serves one TLS client at a time by
+   design, so the ~22 KB (server ctx + iobuf_in + iobuf_out) come from a
+   fixed pool instead of the heap, keeping the accept path free of large
+   allocations.
+   v2: the pool used to be two file-scope statics — 21.5 KB of BSS paid by
+   EVERY config, including HTTP-only setups where no TLS accept can ever
+   happen (measured cost: idle free heap 38 KB -> 16 KB, which starved the
+   telemetry heap gates). It is now reserved by
+   simut_reserve_tls_server_pool(), which the sketch calls once at boot and
+   ONLY when the HTTPS server is actually starting — same steady state for
+   TLS setups (one early allocation from a fresh, unfragmented heap; accepts
+   stay malloc-free), zero cost for HTTP-only setups. With no pool reserved,
+   accepts fall back to the per-accept heap allocations (the pre-pool
+   behaviour). The heap fallback also covers the pool still being referenced
+   by a dying connection (overlapping teardown) and setBufferSizes asking
+   for more than the pool holds. The busy flag is released by the iobuf_out
+   deleter — the last of the three _freeSSL( ) clears. Accepts only happen
+   on core 0, so the flag needs no atomics. Sizes: 16709 =
+   BR_SSL_BUFSIZE_INPUT (default server iobuf_in), 1024 = default server
+   iobuf_out. */
+static constexpr size_t SIMUT_SRV_IOBUF_POOL_SIZE = 16709 + 1024;
+static br_ssl_server_context* s_srv_ctx_pool = nullptr;
+static unsigned char* s_srv_iobuf_pool = nullptr;
+static volatile bool s_srv_pool_busy = false;
+
+extern "C" bool simut_reserve_tls_server_pool(void) {
+    if (!s_srv_ctx_pool) {
+        s_srv_ctx_pool = (br_ssl_server_context*)malloc(sizeof(br_ssl_server_context));
+    }
+    if (!s_srv_iobuf_pool) {
+        s_srv_iobuf_pool = (unsigned char*)malloc(SIMUT_SRV_IOBUF_POOL_SIZE);
+    }
+    if (!s_srv_ctx_pool || !s_srv_iobuf_pool) {
+        free(s_srv_ctx_pool);
+        s_srv_ctx_pool = nullptr;
+        free(s_srv_iobuf_pool);
+        s_srv_iobuf_pool = nullptr;
+        return false;
+    }
+    return true;
+}
