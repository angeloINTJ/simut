+/* SIMUT override — bounded raw-body read for the RAW upload path below.
+ *
+ * The stock RAW loop calls client->readBytes(buf, HTTP_RAW_BUFLEN), and
+ * Stream::readBytes waits the client timeout PER BYTE, resetting it on every
+ * byte. A peer trickling the body keeps that ONE call inside timedRead for
+ * content-length seconds — so feeding the watchdog only at the top of the outer
+ * loop never runs, and Core 0 crosses the 8388 ms window inside a single
+ * readBytes. /api/upload and /api/restore rebooted exactly this way on the bench
+ * 2026-08-10 (C0=[WEB_POLL] hp=0 (219)), after the plain-body and header parses
+ * were already bounded — the RAW path was the one still open.
+ *
+ * This reads only what is already buffered (so readBytes cannot block), feeds
+ * the watchdog while it waits, and gives up after a short no-data window so an
+ * abandoned upload ends as RAW_ABORTED instead of a reboot. No whole-transfer
+ * cap: a real firmware/file upload is long and flash-bound, and capping it would
+ * truncate a legitimate transfer. A continuous upload sees available() > 0 every
+ * iteration and streams at full speed. */
+static size_t simutReadRaw(WiFiClient* client, uint8_t* buf, size_t maxLen) {
+    const uint32_t idleDeadline = millis() + SIMUT_PARSE_BUDGET_MS;  /* no data for the budget => give up */
+    for (;;) {
+        watchdog_update();
+        size_t avail = client->available();
+        if (avail) {
+            if (avail > maxLen) {
+                avail = maxLen;
+            }
+            return client->readBytes(buf, avail);   /* these bytes are buffered — returns at once */
+        }
+        if ((int32_t)(millis() - idleDeadline) >= 0) {
+            return 0;    /* caller turns 0 into RAW_ABORTED / CLIENT_MUST_STOP */
+        }
+        if (!client->connected()) {
+            return 0;
+        }
+        delay(1);
+    }
+}
