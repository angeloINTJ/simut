+/* SIMUT override — a short write ends the response.
+ *
+ * The client's write( ) gives up when it cannot hand all its bytes to lwIP
+ * within the client's timeout, waiting for the peer's ACKs to free room, and
+ * returns what it took. Upstream dropped that count on every write of a
+ * response, the header and each chunk's size line, data and CRLF alike, and
+ * went on with the next one: the bytes a write did not take left a hole in
+ * the middle of the stream, framed as if nothing had happened.
+ * Measured on the bench (2026-10-14, SIMUT release 2.11.1, GET /api/status
+ * every 0.2 s on one keep-alive connection): 24 of 2,000 replies came with one
+ * or two whole writes missing, such as a chunk's size line followed directly
+ * by the next chunk's, and each of those replies took 1.2 to 1.8 s more than
+ * the 0.04 s of a good one, the client's timeout and more.
+ *
+ * Now the first write that comes back short ends the response: nothing more
+ * of it is written, the connection is closed (stopClient( ), as the client's
+ * own type, so over TLS too), and shortWrites( ) counts it.
+ * The client sees a reply cut short, which every HTTP client reports as such,
+ * where it used to get a stream that lied. A write to a peer that has already
+ * gone is not counted: that is a disconnect, and the sketch counts those.
+ * A response cut short leaves _chunked set; _parseRequest( ) clears it for the
+ * next request, as it always has. _handleRequest( ) and _prepareHeader( )
+ * clear _writeBroken. */
+void HTTPServer::_shortWrite() {
+    _writeBroken = true;
+    if (_currentClient->connected()) {
+        _shortWrites++;
+        _currentClientStop(1);  /* 1 ms: the flush cannot finish, close now */
+    }
+}
+
+bool HTTPServer::_writeAll(const char* b, size_t l) {
+    if (_writeBroken) {
+        return false;
+    }
+    if (l == 0 || _currentClientWrite(b, l) == l) {
+        return true;
+    }
+    _shortWrite();
+    return false;
+}
+
+bool HTTPServer::_writeAll_P(PGM_P b, size_t l) {
+    if (_writeBroken) {
+        return false;
+    }
+    if (l == 0 || _currentClientWrite_P(b, l) == l) {
+        return true;
+    }
+    _shortWrite();
+    return false;
+}
