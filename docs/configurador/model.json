    {
      "id": "cli_full",
      "group": "interface",
      "label": {
        "en": "Full command line",
        "pt": "Linha de comando completa"
      },
      "help": {
        "en": "Every serial and Bluetooth command. Without it only the emergency console remains.",
        "pt": "Todos os comandos por serial e Bluetooth. Sem ela fica só o console de emergência."
      }
    },
    {
      "id": "web_https",
      "group": "network",
      "label": {
        "en": "HTTPS web server",
        "pt": "Servidor web HTTPS"
      },
      "help": {
        "en": "Serves the web interface over TLS. Without it the device answers plain HTTP only.",
        "pt": "Serve a interface web por TLS. Sem ele o aparelho responde só em HTTP."
      }
    },
    {
      "id": "license_stub",
      "group": "bench",
      "label": {
        "en": "Short license text on the touch display",
        "pt": "Texto curto da licença na tela touch"
      },
      "help": {
        "en": "The touch display's License screen shows two lines that point to the LICENSE file instead of the full MIT text and credits. The /license web page always keeps the full text.",
        "pt": "A tela de Licença do mostrador touch mostra duas linhas que apontam para o arquivo LICENSE, em vez do texto MIT completo e dos créditos. A página web /license mantém sempre o texto completo."
      }
    },
    {
      "id": "mdns",
      "group": "network",
      "label": {
        "en": "Find by name on the network (mDNS)",
        "pt": "Achar pelo nome na rede (mDNS)"
      },
      "help": {
        "en": "Answers to <device name>.local, so a browser finds it without the IP address.",
        "pt": "Responde por <nome do aparelho>.local, para o navegador achá-lo sem o endereço IP."
      }
    },
    {
      "id": "concurrency_asserts",
      "group": "bench",
      "label": {
        "en": "Concurrency tripwire",
        "pt": "Armadilha de concorrência"
      },
      "help": {
        "en": "Logs an error when a flash operation starts while the state mutex is held. For soak runs, not for field images.",
        "pt": "Registra um erro quando uma operação de flash começa com o mutex de estado preso. Para soak, não para campo."
      }
    },
    {
      "id": "bluetooth",
      "group": "network",
      "label": {
        "en": "Bluetooth serial console",
        "pt": "Console serial por Bluetooth"
      },
      "help": {
        "en": "A password-protected console over classic Bluetooth (SPP). It advertises for the first 5 minutes after power-up, so it reaches a device whose Wi-Fi is not set up yet.",
        "pt": "Um console protegido por senha, por Bluetooth clássico (SPP). Ele se anuncia nos primeiros 5 minutos depois de ligar e assim alcança um aparelho com o Wi-Fi ainda por configurar."
      }
    },
    {
      "id": "air",
      "group": "power",
      "label": {
        "en": "Hibernation between readings",
        "pt": "Hibernação entre leituras"
      },
      "help": {
        "en": "The Air cycle: wake, read, send, sleep. Exists only without a display.",
        "pt": "O ciclo do Air: acorda, lê, envia, dorme. Só existe sem mostrador."
      }
    },
    {
      "id": "sound_buzzer",
      "group": "sound",
      "label": {
        "en": "Buzzer sounds",
        "pt": "Sons no buzzer"
      },
      "help": {
        "en": "Touch clicks, confirmations and alarm sounds on the buzzer (GP22).",
        "pt": "Cliques de toque, confirmações e sons de alarme no buzzer (GP22)."
      }
    },
    {
      "id": "sensor_ds18b20",
      "group": "sensors",
      "label": {
        "en": "DS18B20 temperature probes",
        "pt": "Sondas de temperatura DS18B20"
      },
      "help": {
        "en": "1-Wire probes, one per pin, each recognized by its serial number.",
        "pt": "Sondas 1-Wire, uma por pino, cada uma reconhecida pelo número de série."
      }
    },
    {
      "id": "sensor_dht22",
      "group": "sensors",
      "label": {
        "en": "DHT22 temperature and humidity",
        "pt": "DHT22 temperatura e umidade"
      },
      "help": {
        "en": "One sensor per pin.",
        "pt": "Um sensor por pino."
      }
    },
    {
      "id": "sensor_bme280",
      "group": "sensors",
      "label": {
        "en": "BME280 / BMP280 temperature, humidity and pressure",
        "pt": "BME280 / BMP280 temperatura, umidade e pressão"
      },
      "help": {
        "en": "I2C sensor on a pin pair; the BMP280 variant has no humidity.",
        "pt": "Sensor I2C num par de pinos; a variante BMP280 não mede umidade."
      }
    },
    {
      "id": "tel_tls",
      "group": "telemetry",
      "label": {
        "en": "Encrypted telemetry (HTTPS and MQTTS)",
        "pt": "Telemetria criptografada (HTTPS e MQTTS)"
      },
      "help": {
        "en": "Sends to the collector over TLS, and validates it against /cert.pem when one is uploaded. Without it telemetry goes over plain HTTP or MQTT only, and a configuration that asks for encryption is refused instead of being sent in the clear.",
        "pt": "Envia ao coletor por TLS, e o valida contra o /cert.pem quando há um. Sem ela a telemetria vai só por HTTP ou MQTT sem criptografia, e uma configuração que pede criptografia é recusada em vez de ir em claro."
      }
    }
  ],
